rules_version = '2';

// Deploy with:  firebase deploy --only storage
service firebase.storage {
  match /b/{bucket}/o {
    // vault_tab.dart uploads to vault/{userId}/{timestamp}_{fileName}
    match /vault/{userId}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == userId
        // 25 MB cap and PDF/JPEG/PNG only, matching the file_picker
        // allowedExtensions in vault_tab.dart.
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('application/pdf|image/jpeg|image/png');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
